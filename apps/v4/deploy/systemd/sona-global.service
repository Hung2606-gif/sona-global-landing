[Unit]
Description=SONA-GLOBAL Next.js application
After=network.target

[Service]
Type=simple
User=sona-global
Group=sona-global
WorkingDirectory=/var/www/sona-global
EnvironmentFile=/etc/sona-global/sona-global.env
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/pnpm --filter v4 start
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
