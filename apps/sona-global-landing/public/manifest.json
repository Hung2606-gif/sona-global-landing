  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", ".pdf", ".doc", ".docx"]
        }
      ]
    }
  },
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.sonaglobal.app",
      "id": "com.sonaglobal.app"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/sona-global/id123456789"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+sonaglobal",
      "url": "./?action=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "./file-handler",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg", ".gif", ".webp"],
        "application/pdf": [".pdf"]
      }
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  }
